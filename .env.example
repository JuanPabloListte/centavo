# Copiar a .env . El .env no se versiona.

# Usuario y nombre de la base DENTRO de Postgres. Quedaron de cuando el proyecto
# se llamaba Libro Mayor: renombrarlos toca la base con datos (ver TRASPASO.md).
POSTGRES_USER=libro
POSTGRES_PASSWORD=libro
POSTGRES_DB=libro_mayor

# 5433 y no 5432: si ya tenés un Postgres local corriendo, no chocan.
POSTGRES_PORT=5433

# 127.0.0.1 y no localhost: en Windows, localhost prueba primero IPv6 (::1), donde
# Postgres no escucha, y cada conexión espera a que ese intento venza.
DATABASE_URL=postgresql://libro:libro@127.0.0.1:5433/libro_mayor

# --- modelo local ---
OLLAMA_BASE_URL=http://localhost:11434/v1
CENTAVO_MODELO=qwen2.5:7b
CENTAVO_UMBRAL_CONFIANZA=0.75
CENTAVO_MAX_REPARACIONES=2
